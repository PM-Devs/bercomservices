<section class="bc-section <%= data.sectionBg || 'bc-section-light' %>" <% if (anchorId) { %>id="<%= anchorId %>"<% } %>>
    <div class="container">
        <div class="text-center mb-5 wow fadeInUp" data-wow-delay="0.1s">
            <% if (data.label) { %><span class="bc-section-label"><%= data.label %></span><% } %>
            <h2 class="bc-section-title"><%= data.title %></h2>
        </div>

        <% if ((data.variant || 'carousel') === 'carousel') { %>
        <div class="bc-testimonial-carousel owl-carousel">
            <% testimonials.forEach(function (t) { %>
                <div class="bc-tcard-item">
                    <%- include('_testimonialCard', { t: t }) %>
                </div>
            <% }); %>
        </div>
        <% } else { %>
        <div class="row g-4">
            <% testimonials.forEach(function (t, i) { %>
                <div class="col-md-6 col-lg-4 wow fadeInUp" data-wow-delay="<%= (0.1 + (i % 3) * 0.1).toFixed(1) %>s">
                    <%- include('_testimonialCard', { t: t }) %>
                </div>
            <% }); %>
        </div>
        <% } %>
    </div>
</section>
