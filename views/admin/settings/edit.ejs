<form method="POST" action="/admin/settings?_method=PUT">
    <div class="admin-card mb-3">
        <h6 class="fw-bold mb-3">Company Identity</h6>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label small">Company Name</label>
                <input type="text" name="companyName" class="form-control" value="<%= settings.companyName %>">
            </div>
            <div class="col-md-4">
                <label class="form-label small">Company Sub-label</label>
                <input type="text" name="companySub" class="form-control" value="<%= settings.companySub %>">
            </div>
            <div class="col-md-4">
                <label class="form-label small">Founding Year</label>
                <input type="number" name="foundingYear" class="form-control" value="<%= settings.foundingYear %>">
            </div>
            <div class="col-12">
                <label class="form-label small">Tagline</label>
                <input type="text" name="tagline" class="form-control" value="<%= settings.tagline %>">
            </div>
        </div>
    </div>

    <div class="admin-card mb-3">
        <h6 class="fw-bold mb-3">Contact Info</h6>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label small">Address</label>
                <input type="text" name="address" class="form-control" value="<%= settings.address %>">
            </div>
            <div class="col-md-6">
                <label class="form-label small">Google Maps Query</label>
                <input type="text" name="mapQuery" class="form-control" value="<%= settings.mapQuery %>">
            </div>
            <div class="col-md-6">
                <label class="form-label small">Map Section Heading</label>
                <input type="text" name="mapHeading" class="form-control" value="<%= settings.mapHeading || 'Our Office Location' %>">
            </div>
            <div class="col-md-6">
                <label class="form-label small">Map Section Introduction</label>
                <input type="text" name="mapIntro" class="form-control" value="<%= settings.mapIntro || '' %>">
            </div>
            <div class="col-md-4">
                <label class="form-label small">Email</label>
                <input type="email" name="email" class="form-control" value="<%= settings.email %>">
            </div>
            <div class="col-md-4">
                <label class="form-label small">Phone</label>
                <input type="text" name="phone" class="form-control" value="<%= settings.phone %>">
            </div>
            <div class="col-md-4">
                <label class="form-label small">Website</label>
                <input type="text" name="website" class="form-control" value="<%= settings.website %>">
            </div>
        </div>
    </div>

    <div class="admin-card mb-3">
        <h6 class="fw-bold mb-3">Social Links</h6>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label small">LinkedIn URL</label>
                <input type="text" name="linkedin" class="form-control" value="<%= settings.socialLinks.linkedin %>">
            </div>
            <div class="col-md-4">
                <label class="form-label small">Facebook URL</label>
                <input type="text" name="facebook" class="form-control" value="<%= settings.socialLinks.facebook %>">
            </div>
            <div class="col-md-4">
                <label class="form-label small">Twitter URL</label>
                <input type="text" name="twitter" class="form-control" value="<%= settings.socialLinks.twitter %>">
            </div>
        </div>
    </div>

    <div class="admin-card mb-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0">Navigation Menu</h6>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-repeater-add="nav-repeater">
                <i class="material-icons-round align-middle" style="font-size:1rem;">add</i> Add Nav Item
            </button>
        </div>
        <p class="small text-secondary">Set "Target Slug" to a page slug (home/about/services/courses/team/testimonials/contact) for automatic active-state highlighting, or leave blank and use a raw URL instead. The Services item's dropdown is generated automatically from your Services list.</p>
        <div id="nav-repeater" data-repeater="nav">
            <template>
                <div class="repeater-item row g-2 align-items-end">
                    <button type="button" class="btn btn-sm btn-outline-danger repeater-remove"><i class="material-icons-round" style="font-size:1rem;">close</i></button>
                    <div class="col-md-3"><label class="form-label small">Label</label><input type="text" name="nav[0][label]" class="form-control form-control-sm"></div>
                    <div class="col-md-3"><label class="form-label small">Target Slug</label><input type="text" name="nav[0][targetSlug]" class="form-control form-control-sm"></div>
                    <div class="col-md-3"><label class="form-label small">Anchor ID</label><input type="text" name="nav[0][anchorId]" class="form-control form-control-sm"></div>
                    <div class="col-md-3"><label class="form-label small">Raw href (if no slug)</label><input type="text" name="nav[0][href]" class="form-control form-control-sm"></div>
                </div>
            </template>
            <% settings.nav.forEach(function (item, i) { %>
                <div class="repeater-item row g-2 align-items-end">
                    <button type="button" class="btn btn-sm btn-outline-danger repeater-remove"><i class="material-icons-round" style="font-size:1rem;">close</i></button>
                    <div class="col-md-3"><label class="form-label small">Label</label><input type="text" name="nav[<%= i %>][label]" class="form-control form-control-sm" value="<%= item.label %>"></div>
                    <div class="col-md-3"><label class="form-label small">Target Slug</label><input type="text" name="nav[<%= i %>][targetSlug]" class="form-control form-control-sm" value="<%= item.targetSlug %>"></div>
                    <div class="col-md-3"><label class="form-label small">Anchor ID</label><input type="text" name="nav[<%= i %>][anchorId]" class="form-control form-control-sm" value="<%= item.anchorId %>"></div>
                    <div class="col-md-3"><label class="form-label small">Raw href (if no slug)</label><input type="text" name="nav[<%= i %>][href]" class="form-control form-control-sm" value="<%= item.href %>"></div>
                </div>
            <% }); %>
        </div>
    </div>

    <div class="admin-card mb-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0">Footer</h6>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-repeater-add="quicklinks-repeater">
                <i class="material-icons-round align-middle" style="font-size:1rem;">add</i> Add Quick Link
            </button>
        </div>
        <div class="mb-3">
            <label class="form-label small">Brand Blurb</label>
            <textarea name="footerBlurb" class="form-control" rows="2"><%= settings.footer.blurb %></textarea>
        </div>
        <label class="form-label small">Quick Links</label>
        <div id="quicklinks-repeater" data-repeater="quickLinks" class="mb-3">
            <template>
                <div class="repeater-item row g-2 align-items-end">
                    <button type="button" class="btn btn-sm btn-outline-danger repeater-remove"><i class="material-icons-round" style="font-size:1rem;">close</i></button>
                    <div class="col-md-6"><input type="text" name="quickLinkLabel" class="form-control form-control-sm" placeholder="Label"></div>
                    <div class="col-md-6"><input type="text" name="quickLinkHref" class="form-control form-control-sm" placeholder="/path"></div>
                </div>
            </template>
            <% settings.footer.quickLinks.forEach(function (link) { %>
                <div class="repeater-item row g-2 align-items-end">
                    <button type="button" class="btn btn-sm btn-outline-danger repeater-remove"><i class="material-icons-round" style="font-size:1rem;">close</i></button>
                    <div class="col-md-6"><input type="text" name="quickLinkLabel" class="form-control form-control-sm" value="<%= link.label %>" placeholder="Label"></div>
                    <div class="col-md-6"><input type="text" name="quickLinkHref" class="form-control form-control-sm" value="<%= link.href %>" placeholder="/path"></div>
                </div>
            <% }); %>
        </div>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label small">Copyright Text</label>
                <input type="text" name="copyrightText" class="form-control" value="<%= settings.footer.copyrightText %>">
            </div>
            <div class="col-md-6">
                <label class="form-label small">Developer Credit (HTML allowed)</label>
                <input type="text" name="developerCredit" class="form-control" value="<%= settings.footer.developerCredit %>">
            </div>
        </div>
    </div>

    <div class="admin-card mb-3">
        <h6 class="fw-bold mb-3">Prospect Research Agent</h6>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label small">Cron Schedule</label>
                <input type="text" name="cronSchedule" class="form-control" value="<%= settings.research.cronSchedule %>">
                <span class="small text-secondary">Standard cron syntax. Default "0 6 * * *" = daily at 6am. Requires a server restart to apply.</span>
            </div>
            <div class="col-md-6">
                <label class="form-label small">Confidence Threshold (0–1)</label>
                <input type="number" step="0.05" min="0" max="1" name="confidenceThreshold" class="form-control" value="<%= settings.research.confidenceThreshold %>">
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input type="checkbox" name="autoRunEnabled" class="form-check-input" id="autoRunEnabled" <%= settings.research.autoRunEnabled ? 'checked' : '' %>>
                    <label class="form-check-label small" for="autoRunEnabled">Run automatically on the schedule above</label>
                </div>
            </div>
            <div class="col-12">
                <label class="form-label small">Search Queries (one per line)</label>
                <textarea name="researchQueries" class="form-control" rows="5"><%= settings.research.queries.join('\n') %></textarea>
            </div>
        </div>
    </div>

    <button type="submit" class="btn bc-btn-primary">Save Settings</button>
</form>
