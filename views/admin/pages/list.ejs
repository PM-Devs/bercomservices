<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-secondary mb-0"><%= pages.length %> page<%= pages.length === 1 ? '' : 's' %></p>
    <a href="/admin/pages/new" class="btn bc-btn-primary btn-sm">
        <i class="material-icons-round align-middle" style="font-size:1rem;">add</i> New Page
    </a>
</div>

<div class="admin-card p-0">
    <table class="table admin-table mb-0">
        <thead><tr><th>Title</th><th>Slug</th><th>Sections</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
            <% pages.forEach(function (page) { %>
                <tr>
                    <td><%= page.title %></td>
                    <td><code>/<%= page.slug === 'home' ? '' : page.slug %></code></td>
                    <td><%= (page.sections || []).length %></td>
                    <td>
                        <% if (page.published) { %><span class="badge badge-status-approved">Published</span><% } else { %><span class="badge badge-status-rejected">Draft</span><% } %>
                    </td>
                    <td class="text-end">
                        <a href="/admin/pages/<%= page._id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form action="/admin/pages/<%= page._id %>?_method=DELETE" method="POST" class="d-inline" data-confirm="Delete this page and all its sections?">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</div>
