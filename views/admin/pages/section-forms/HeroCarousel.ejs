<% var d = section.data || {}; var slides = d.slides || []; var chips = d.quickChips || []; %>
<%- include('_top', { page, section }) %>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="form-check">
            <input type="checkbox" name="showQuickForm" class="form-check-input" id="showQuickForm" <%= d.showQuickForm !== false ? 'checked' : '' %>>
            <label class="form-check-label small fw-medium" for="showQuickForm">Show floating "quick request" form on the hero photo</label>
        </div>
    </div>
    <div class="col-md-8">
        <label class="form-label small fw-medium">Quick Form Title</label>
        <input type="text" name="quickFormTitle" class="form-control" value="<%= d.quickFormTitle || 'Send a Request' %>">
    </div>
</div>
<p class="small text-secondary">The quick-request form posts straight to your Contact page's handler — no separate setup needed.</p>

<div class="d-flex justify-content-between align-items-center mb-2">
    <label class="form-label small fw-medium mb-0">Slides (full-bleed background photo)</label>
    <button type="button" class="btn btn-sm btn-outline-secondary" data-repeater-add="slides-repeater">Add Slide</button>
</div>
<div id="slides-repeater" class="mb-4">
    <template>
        <div class="repeater-item">
            <button type="button" class="btn btn-sm btn-outline-danger repeater-remove"><i class="material-icons-round" style="font-size:1rem;">close</i></button>
            <div class="row g-2">
                <div class="col-md-6"><label class="form-label small">Badge</label><input type="text" name="slideBadge" class="form-control form-control-sm"></div>
                <div class="col-md-6"><label class="form-label small">Title</label><input type="text" name="slideTitle" class="form-control form-control-sm"></div>
                <div class="col-12"><label class="form-label small">Subtitle</label><textarea name="slideSubtitle" class="form-control form-control-sm" rows="2"></textarea></div>
                <div class="col-12">
                    <label class="form-label small">Photo</label>
                    <div class="input-group">
                        <input type="text" name="slideBgImage" class="form-control form-control-sm" placeholder="/uploads/filename.jpg">
                        <a href="/admin/media" target="_blank" class="btn btn-outline-secondary btn-sm">Browse</a>
                    </div>
                </div>
                <input type="hidden" name="slideBgImageClass" value="">
                <div class="col-md-3"><label class="form-label small">Primary CTA Label</label><input type="text" name="slideCtaPrimaryLabel" class="form-control form-control-sm"></div>
                <div class="col-md-3"><label class="form-label small">Primary CTA Href</label><input type="text" name="slideCtaPrimaryHref" class="form-control form-control-sm"></div>
                <div class="col-md-3"><label class="form-label small">Secondary CTA Label</label><input type="text" name="slideCtaSecondaryLabel" class="form-control form-control-sm"></div>
                <div class="col-md-3"><label class="form-label small">Secondary CTA Href</label><input type="text" name="slideCtaSecondaryHref" class="form-control form-control-sm"></div>
            </div>
        </div>
    </template>
    <% slides.forEach(function (s) { %>
        <div class="repeater-item">
            <button type="button" class="btn btn-sm btn-outline-danger repeater-remove"><i class="material-icons-round" style="font-size:1rem;">close</i></button>
            <div class="row g-2">
                <div class="col-md-6"><label class="form-label small">Badge</label><input type="text" name="slideBadge" class="form-control form-control-sm" value="<%= s.badge %>"></div>
                <div class="col-md-6"><label class="form-label small">Title</label><input type="text" name="slideTitle" class="form-control form-control-sm" value="<%= s.title %>"></div>
                <div class="col-12"><label class="form-label small">Subtitle</label><textarea name="slideSubtitle" class="form-control form-control-sm" rows="2"><%= s.subtitle %></textarea></div>
                <div class="col-12">
                    <label class="form-label small">Photo</label>
                    <div class="input-group">
                        <input type="text" name="slideBgImage" class="form-control form-control-sm" value="<%= s.bgImage %>" placeholder="/uploads/filename.jpg">
                        <a href="/admin/media" target="_blank" class="btn btn-outline-secondary btn-sm">Browse</a>
                    </div>
                    <% if (s.bgImage) { %><img src="<%= s.bgImage %>" class="mt-2" style="height:60px;border-radius:6px;"><% } %>
                </div>
                <input type="hidden" name="slideBgImageClass" value="<%= s.bgImageClass %>">
                <div class="col-md-3"><label class="form-label small">Primary CTA Label</label><input type="text" name="slideCtaPrimaryLabel" class="form-control form-control-sm" value="<%= s.ctaPrimary && s.ctaPrimary.label %>"></div>
                <div class="col-md-3"><label class="form-label small">Primary CTA Href</label><input type="text" name="slideCtaPrimaryHref" class="form-control form-control-sm" value="<%= s.ctaPrimary && s.ctaPrimary.href %>"></div>
                <div class="col-md-3"><label class="form-label small">Secondary CTA Label</label><input type="text" name="slideCtaSecondaryLabel" class="form-control form-control-sm" value="<%= s.ctaSecondary && s.ctaSecondary.label %>"></div>
                <div class="col-md-3"><label class="form-label small">Secondary CTA Href</label><input type="text" name="slideCtaSecondaryHref" class="form-control form-control-sm" value="<%= s.ctaSecondary && s.ctaSecondary.href %>"></div>
            </div>
        </div>
    <% }); %>
</div>

<p class="small text-secondary">Small floating chips scattered over the hero photo (e.g. quick service tags).</p>
<div class="d-flex justify-content-between align-items-center mb-2">
    <label class="form-label small fw-medium mb-0">Floating Chips</label>
    <button type="button" class="btn btn-sm btn-outline-secondary" data-repeater-add="chip-repeater">Add Chip</button>
</div>
<div id="chip-repeater">
    <template>
        <div class="repeater-item row g-2 align-items-end">
            <button type="button" class="btn btn-sm btn-outline-danger repeater-remove"><i class="material-icons-round" style="font-size:1rem;">close</i></button>
            <div class="col-md-4"><label class="form-label small">Icon</label><input type="text" name="chipIcon" class="form-control form-control-sm"></div>
            <div class="col-md-8"><label class="form-label small">Label</label><input type="text" name="chipLabel" class="form-control form-control-sm"></div>
        </div>
    </template>
    <% chips.forEach(function (c) { %>
        <div class="repeater-item row g-2 align-items-end">
            <button type="button" class="btn btn-sm btn-outline-danger repeater-remove"><i class="material-icons-round" style="font-size:1rem;">close</i></button>
            <div class="col-md-4"><label class="form-label small">Icon</label><input type="text" name="chipIcon" class="form-control form-control-sm" value="<%= c.icon %>"></div>
            <div class="col-md-8"><label class="form-label small">Label</label><input type="text" name="chipLabel" class="form-control form-control-sm" value="<%= c.label %>"></div>
        </div>
    <% }); %>
</div>

<%- include('_bottom', { page, section }) %>
