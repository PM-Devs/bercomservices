<% var d = section.data || {}; var items = d.items || []; %>
<%- include('_top', { page, section }) %>

<div class="mb-3">
    <label class="form-label small fw-medium">Display Style</label>
    <select name="variant" class="form-select">
        <option value="strip" <%= (d.variant || 'strip') === 'strip' ? 'selected' : '' %>>Full-width strip (dark, e.g. homepage stats)</option>
        <option value="chips" <%= d.variant === 'chips' ? 'selected' : '' %>>Chip row (light cards, e.g. testimonials intro)</option>
    </select>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <label class="form-label small fw-medium mb-0">Items</label>
    <button type="button" class="btn btn-sm btn-outline-secondary" data-repeater-add="items-repeater">Add Item</button>
</div>
<div id="items-repeater">
    <template>
        <div class="repeater-item row g-2 align-items-end">
            <button type="button" class="btn btn-sm btn-outline-danger repeater-remove"><i class="material-icons-round" style="font-size:1rem;">close</i></button>
            <div class="col-md-6"><label class="form-label small">Value</label><input type="text" name="itemValue" class="form-control form-control-sm"></div>
            <div class="col-md-6"><label class="form-label small">Label</label><input type="text" name="itemLabel" class="form-control form-control-sm"></div>
        </div>
    </template>
    <% items.forEach(function (item) { %>
        <div class="repeater-item row g-2 align-items-end">
            <button type="button" class="btn btn-sm btn-outline-danger repeater-remove"><i class="material-icons-round" style="font-size:1rem;">close</i></button>
            <div class="col-md-6"><label class="form-label small">Value</label><input type="text" name="itemValue" class="form-control form-control-sm" value="<%= item.value %>"></div>
            <div class="col-md-6"><label class="form-label small">Label</label><input type="text" name="itemLabel" class="form-control form-control-sm" value="<%= item.label %>"></div>
        </div>
    <% }); %>
</div>

<%- include('_bottom', { page, section }) %>
