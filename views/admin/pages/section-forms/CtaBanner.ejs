<% var d = section.data || {}; var buttons = d.buttons || []; %>
<%- include('_top', { page, section }) %>

<div class="row g-3 mb-3">
    <div class="col-md-4"><label class="form-label small fw-medium">Label</label><input type="text" name="label" class="form-control" value="<%= d.label %>"></div>
    <div class="col-md-4"><label class="form-label small fw-medium">Title</label><input type="text" name="title" class="form-control" value="<%= d.title %>"></div>
    <div class="col-md-4"><label class="form-label small fw-medium">Theme</label>
        <select name="theme" class="form-select">
            <option value="light" <%= d.theme !== 'dark' ? 'selected' : '' %>>Light</option>
            <option value="dark" <%= d.theme === 'dark' ? 'selected' : '' %>>Dark</option>
        </select>
    </div>
    <div class="col-12"><label class="form-label small fw-medium">Body Text</label><textarea name="text" class="form-control" rows="2"><%= d.text %></textarea></div>
    <div class="col-12">
        <label class="form-label small fw-medium">Background Photo (optional — overrides the Light/Dark theme with a full photo background)</label>
        <div class="input-group">
            <input type="text" name="backgroundPhoto" class="form-control" value="<%= d.backgroundPhoto %>" placeholder="/uploads/filename.jpg">
            <a href="/admin/media" target="_blank" class="btn btn-outline-secondary">Browse</a>
        </div>
        <% if (d.backgroundPhoto) { %><img src="<%= d.backgroundPhoto %>" class="mt-2" style="height:60px;border-radius:6px;"><% } %>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <label class="form-label small fw-medium mb-0">Buttons</label>
    <button type="button" class="btn btn-sm btn-outline-secondary" data-repeater-add="btn-repeater">Add Button</button>
</div>
<div id="btn-repeater">
    <template>
        <div class="repeater-item row g-2 align-items-end">
            <button type="button" class="btn btn-sm btn-outline-danger repeater-remove"><i class="material-icons-round" style="font-size:1rem;">close</i></button>
            <div class="col-md-4"><label class="form-label small">Label</label><input type="text" name="btnLabel" class="form-control form-control-sm"></div>
            <div class="col-md-4"><label class="form-label small">Href</label><input type="text" name="btnHref" class="form-control form-control-sm"></div>
            <div class="col-md-4"><label class="form-label small">Icon (optional)</label><input type="text" name="btnIcon" class="form-control form-control-sm"></div>
        </div>
    </template>
    <% buttons.forEach(function (btn) { %>
        <div class="repeater-item row g-2 align-items-end">
            <button type="button" class="btn btn-sm btn-outline-danger repeater-remove"><i class="material-icons-round" style="font-size:1rem;">close</i></button>
            <div class="col-md-4"><label class="form-label small">Label</label><input type="text" name="btnLabel" class="form-control form-control-sm" value="<%= btn.label %>"></div>
            <div class="col-md-4"><label class="form-label small">Href</label><input type="text" name="btnHref" class="form-control form-control-sm" value="<%= btn.href %>"></div>
            <div class="col-md-4"><label class="form-label small">Icon (optional)</label><input type="text" name="btnIcon" class="form-control form-control-sm" value="<%= btn.icon %>"></div>
        </div>
    <% }); %>
</div>

<%- include('_bottom', { page, section }) %>
